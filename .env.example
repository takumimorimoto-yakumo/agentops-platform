# AgentOps Platform — environment configuration example
# Copy this file to .env and fill in your values.
# Never commit .env to source control.

# ── Server ────────────────────────────────────────────────────────────────────
# Host and port for the uvicorn server (overridden by Cloud Run via PORT env var)
AGENTOPS_HOST=0.0.0.0
AGENTOPS_PORT=8080

# ── Persistence ───────────────────────────────────────────────────────────────
# "memory" = in-process dict (default for local dev / tests)
# "sqlite"  = SQLite file at AGENTOPS_DB_URL
AGENTOPS_REPOSITORY_BACKEND=memory

# SQLite URL used when AGENTOPS_REPOSITORY_BACKEND=sqlite
AGENTOPS_DB_URL=sqlite:///./agentops.db

# ── Evaluation ────────────────────────────────────────────────────────────────
# Gemini model used as judge for drift scoring (e.g. gemini-2.0-flash)
# Required for the real Gemini judge; ignored by the stub judge.
AGENTOPS_JUDGE_MODEL=gemini-2.0-flash

# Judge implementation: "stub" (deterministic, no LLM call) | "gemini" (real judge)
AGENTOPS_JUDGE_BACKEND=stub

# ── Gemini backend ────────────────────────────────────────────────────────────
# Controls which Google SDK is used to call Gemini.
#
# "aistudio" (default):
#   Uses the google-generativeai SDK with GOOGLE_API_KEY.
#   Suitable for individual developers and quick prototyping.
#
# "vertex":
#   Uses the Vertex AI SDK (google-cloud-aiplatform) with ADC — no API key needed.
#   Run: gcloud auth application-default login
#   Suitable for production deployments on Google Cloud.
AGENTOPS_GEMINI_BACKEND=aistudio

# AI Studio API key — required when AGENTOPS_GEMINI_BACKEND=aistudio.
# Obtain from: https://aistudio.google.com/app/apikey
# The google-generativeai SDK picks this up automatically from GOOGLE_API_KEY.
# You may also set AGENTOPS_GOOGLE_API_KEY to override via the platform config.
# Leave blank when using Vertex AI (ADC is used instead).
GOOGLE_API_KEY=

# ── Google Cloud ──────────────────────────────────────────────────────────────
# GCP project ID — required when AGENTOPS_GEMINI_BACKEND=vertex.
AGENTOPS_GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# GCP region for Cloud Run and other GCP infrastructure.
AGENTOPS_GOOGLE_CLOUD_REGION=asia-northeast1

# Vertex AI region — required when AGENTOPS_GEMINI_BACKEND=vertex.
# Must be a region that supports the chosen Gemini model.
# Common choices: us-central1, asia-northeast1 (Tokyo)
AGENTOPS_GOOGLE_CLOUD_LOCATION=asia-northeast1

# ── Canary defaults ───────────────────────────────────────────────────────────
# Default canary steps (comma-separated traffic percentages)
AGENTOPS_CANARY_DEFAULT_STEPS=10,25,50,100

# Default rollback-policy window in minutes
AGENTOPS_ROLLBACK_WINDOW_MINUTES=15

# ── Auth ──────────────────────────────────────────────────────────────────────
# Set to "none" to disable bearer-token verification in local dev.
# In production Cloud Run, verification is done by Google-signed ID tokens.
AGENTOPS_AUTH_MODE=none
